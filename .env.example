# --- hosted <=8B OpenAI-compatible endpoint (chat + embeddings) ---
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-endpoint.example.com/v1
OPENAI_MODEL=qwen-8b-instruct
# A chat model (Qwen-8B-Instruct) cannot produce embeddings: use a separate embedding model on the same host
# (e.g. Qwen3-Embedding-0.6B/4B, bge-m3). Leave empty to use the offline LSA fallback.
EMBEDDING_MODEL=
# Constrained decoding: auto | json_schema | guided_json | json_object | none
CONSTRAINED_MODE=auto                        # run scripts/check_endpoint.py to see which mode your host supports
# Qwen3 emits <think> blocks; auto = switch thinking off when the model name contains 'qwen3'
DISABLE_THINKING=auto

# --- retrieval ---
RERANKER=lexical                             # lexical | cross_encoder | none (cross_encoder needs sentence-transformers)
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# --- agent safety rails ---
MAX_STEPS=8
MAX_LLM_CALLS=8
MAX_QUERY_TOKENS=14000
JSON_RETRIES=2
MAX_TOKENS=700
TOP_K=6
STRATEGY=structured                          # structured | selfconsistency | decomposition | baseline

# --- serving ---
RATE_LIMIT_PER_MIN=10
CACHE_TTL_S=900
PRICE_IN_PER_M=0.05                          # USD per 1M tokens, for the cost estimate
PRICE_OUT_PER_M=0.10

# --- optional Langfuse tracing (JSONL traces are always written to ./traces) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
